# Google Forms — copy to .env.local and fill in after creating your forms.
# Form ID: the long string in the published form URL:
#   https://docs.google.com/forms/d/e/FORM_ID_HERE/viewform
#
# Entry IDs: open the form → ⋮ → Get pre-filled link → fill one field → copy entry.XXXXX from URL
#
# For file uploads (CV, documents, papers): add a "File upload" question in Google Forms.
# Uploaded files are stored automatically in the linked Google Drive folder.

# Programme admissions (diplomas, short courses, IERP)
NEXT_PUBLIC_GF_ADMISSIONS_ID=
NEXT_PUBLIC_GF_ADMISSIONS_ENTRY_PROGRAM=
NEXT_PUBLIC_GF_ADMISSIONS_ENTRY_DELIVERY=
NEXT_PUBLIC_GF_ADMISSIONS_ENTRY_NAME=
NEXT_PUBLIC_GF_ADMISSIONS_ENTRY_EMAIL=

# Job applications (specific role)
NEXT_PUBLIC_GF_CAREERS_ID=
NEXT_PUBLIC_GF_CAREERS_ENTRY_POSITION=
NEXT_PUBLIC_GF_CAREERS_ENTRY_NAME=
NEXT_PUBLIC_GF_CAREERS_ENTRY_EMAIL=

# Speculative CV / general careers submission (include File upload question for CV)
NEXT_PUBLIC_GF_CV_ID=

# Research paper submissions (include File upload for manuscript)
NEXT_PUBLIC_GF_RESEARCH_ID=
NEXT_PUBLIC_GF_RESEARCH_ENTRY_JOURNAL=
NEXT_PUBLIC_GF_RESEARCH_ENTRY_TITLE=
NEXT_PUBLIC_GF_RESEARCH_ENTRY_NAME=
NEXT_PUBLIC_GF_RESEARCH_ENTRY_EMAIL=

# Internship applications
NEXT_PUBLIC_GF_INTERNSHIP_ID=
NEXT_PUBLIC_GF_INTERNSHIP_ENTRY_PROGRAM=
NEXT_PUBLIC_GF_INTERNSHIP_ENTRY_NAME=
NEXT_PUBLIC_GF_INTERNSHIP_ENTRY_EMAIL=

# Event registration
NEXT_PUBLIC_GF_EVENT_ID=
NEXT_PUBLIC_GF_EVENT_ENTRY_EVENT=
NEXT_PUBLIC_GF_EVENT_ENTRY_NAME=
NEXT_PUBLIC_GF_EVENT_ENTRY_EMAIL=

# Programme interest / waitlist (launching soon)
NEXT_PUBLIC_GF_INTEREST_ID=
NEXT_PUBLIC_GF_INTEREST_ENTRY_PROGRAM=
NEXT_PUBLIC_GF_INTEREST_ENTRY_DELIVERY=
NEXT_PUBLIC_GF_INTEREST_ENTRY_NAME=
NEXT_PUBLIC_GF_INTEREST_ENTRY_EMAIL=
